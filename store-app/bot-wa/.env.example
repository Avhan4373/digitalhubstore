# URL aplikasi Laravel yang menyediakan /api/bot/*
BOT_API_URL=http://127.0.0.1:8000

# WAJIB — samakan dengan BOT_API_TOKEN di store-app/.env
# Buat dengan: php -r "echo bin2hex(random_bytes(24));"
BOT_API_TOKEN=

# Nomor admin penerima notifikasi pesanan baru (62xxx, pisah koma)
BOT_ADMIN_NUMBERS=6282395124106

# Path Chrome. Kosongkan untuk cari otomatis.
# BOT_CHROME_PATH=./chrome/linux-146.0.7680.153/chrome-linux64/chrome

# Batas pesan masuk per nomor per menit
BOT_RATE_LIMIT=20

# false = tampilkan jendela Chrome (debug)
BOT_HEADLESS=true

# Pin versi WA Web kalau inject sering gagal setelah WhatsApp update
# BOT_WEB_VERSION=2.3000.1012355863

# Kalau diisi, hanya nomor ini yang dilayani. Kosong = semua nomor.
# BOT_ALLOWLIST=6282395124106

# ID grup (@g.us) yang boleh dilayani, dipisah koma. Kosong = SEMUA grup
# diabaikan (setelan produksi). Isi hanya untuk grup uji coba milik sendiri:
#   - kirim pesan apa pun di grup
#   - lihat log bot: "Pesan diabaikan (chat grup)" menunjukkan ID grup di
#     antara tanda kurung, atau lihat ID-nya di panel WhatsApp Web
# BOT_GROUP_ALLOWLIST=120363429581560330@g.us

BOT_LOG_LEVEL=info

# Uji dari nomor yang sama dengan bot (tanpa HP kedua).
# JANGAN aktifkan di produksi.
# BOT_ALLOW_SELF=true
