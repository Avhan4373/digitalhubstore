APP_NAME="Creative Solutions"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL dari docker-compose.yml (host port 3307 supaya tidak bentrok MySQL lokal).
# Jalankan: docker compose up -d
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=digitalhubstore
DB_USERNAME=digitalhub
DB_PASSWORD=digitalhub

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Seed katalog dari hasil scrape (lihat ../data/seed).
# Kosongkan kalau tidak ingin mengimpor katalog hasil scrape.
CATALOG_SEED_DIR=../data/seed

# ---------------------------------------------------------------------------
# Bot WhatsApp (lihat bot-wa/README.md)
#
# Bot berjalan sebagai proses Node terpisah dan memanggil /api/bot/*.
# Tanpa BOT_ENABLED=true dan BOT_API_TOKEN yang cocok, seluruh endpoint bot
# menolak semua permintaan (fail closed).
#
# Buat token acak:  php -r "echo bin2hex(random_bytes(24));"
BOT_ENABLED=false
BOT_API_TOKEN=
BOT_ADMIN_NUMBERS=
BOT_RATE_LIMIT=20
BOT_MAX_PRODUCTS=40

VITE_APP_NAME="${APP_NAME}"
