__pycache__/
*.py[cod]
.venv/
venv/

# Hasil scrape mentah (dibuat ulang oleh scrape.py)
data/*.sqlite
data/*.sqlite-journal
data/raw/
data/export/

# Laravel: cukup andalkan .gitignore bersarang di store-app/.
# JANGAN mengabaikan isi storage/* dari sini — file .gitignore bersarang
# itulah yang membuat direktori framework/{sessions,views} & logs ikut ter-clone.
store-app/vendor/
store-app/node_modules/
store-app/.env
store-app/.env.*
!store-app/.env.example
store-app/public/build/
store-app/public/hot
store-app/public/storage
store-app/storage/*.key
store-app/database/database.sqlite
store-app/.phpunit.cache/
store-app/.phpunit.result.cache
